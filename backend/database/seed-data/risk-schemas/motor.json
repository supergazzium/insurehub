{
  "version": 3,
  "kind": "motor",
  "sections": [
    {
      "key": "vehicle",
      "label_th": "รายละเอียดรถยนต์",
      "label_en": "Vehicle details",
      "fields": [
        {
          "key": "type_driver",
          "label_th": "ระบุผู้ขับขี่หรือไม่",
          "label_en": "Named driver?",
          "type": "radio",
          "required": true,
          "storage": "column",
          "column_name": "motor_type_driver",
          "options": [
            { "value": "named", "label_th": "ระบุ", "label_en": "Named" },
            { "value": "any", "label_th": "ไม่ระบุ", "label_en": "Any driver" }
          ]
        },
        {
          "key": "drivers",
          "label_th": "รายชื่อผู้ขับขี่",
          "label_en": "Named drivers",
          "type": "array_of_objects",
          "show_when": { "field": "type_driver", "equals": "named" },
          "min_rows": 1,
          "max_rows": 5,
          "fields": [
            {
              "key": "name",
              "label_th": "ชื่อ-สกุล",
              "label_en": "Full name",
              "type": "string",
              "required": true,
              "validation": { "max": 128 }
            }
          ]
        },
        {
          "key": "vehicle_brand",
          "label_th": "ยี่ห้อรถ",
          "label_en": "Vehicle brand",
          "type": "remote_select",
          "required": true,
          "storage": "column",
          "column_name": "motor_vehicle_brand",
          "remote_url": "lookups/vehicle-brands",
          "placeholder": "พิมพ์เพื่อค้นหายี่ห้อ...",
          "prior_autofill": true
        },
        {
          "key": "type_vehicle",
          "label_th": "ประเภทรถ",
          "label_en": "Vehicle type",
          "type": "remote_select",
          "required": true,
          "storage": "column",
          "column_name": "motor_type_vehicle",
          "remote_url": "lookups/motor-market-groups",
          "placeholder": "เลือกประเภทรถ..."
        },
        {
          "key": "vehicle_model",
          "label_th": "รุ่นรถ",
          "label_en": "Vehicle model",
          "type": "remote_select",
          "required": true,
          "storage": "column",
          "column_name": "motor_vehicle_model",
          "remote_url": "lookups/vehicle-models",
          "remote_deps": [{ "field": "vehicle_brand", "param": "brand" }],
          "placeholder": "พิมพ์เพื่อค้นหารุ่น...",
          "placeholder_disabled": "เลือกยี่ห้อรถก่อน",
          "prior_autofill": true
        },
        {
          "key": "license_no",
          "label_th": "ทะเบียนรถ",
          "label_en": "License plate",
          "type": "string",
          "required": true,
          "storage": "column",
          "column_name": "motor_license_no",
          "placeholder": "กข 1234",
          "validation": { "min": 1, "max": 32 },
          "prior_autofill": true
        },
        {
          "key": "register_year",
          "label_th": "ปีจดทะเบียน",
          "label_en": "Registration year",
          "type": "string",
          "validation": { "pattern": "^\\d{4}$" },
          "prior_autofill": true
        },
        {
          "key": "chassis_no",
          "label_th": "เลขตัวถัง",
          "label_en": "Chassis number",
          "type": "string",
          "validation": { "max": 64 },
          "prior_autofill": true
        },
        {
          "key": "engine_no",
          "label_th": "เลขเครื่อง",
          "label_en": "Engine number",
          "type": "string",
          "validation": { "max": 64 },
          "prior_autofill": true
        },
        {
          "key": "no_passenger",
          "label_th": "จำนวนที่นั่ง",
          "label_en": "Seats",
          "type": "number",
          "validation": { "min": 1, "max": 99 }
        },
        {
          "key": "notes",
          "label_th": "หมายเหตุ",
          "label_en": "Notes",
          "type": "text",
          "validation": { "max": 1000 }
        }
      ],
      "dedupe_keys": ["license_no", "chassis_no"]
    }
  ]
}
